{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [".idea/**", ".local/**", "web/dist/**", "docs/**"],
  "rules": {
    "curly": "error",
    "no-nested-ternary": "error",
    "import/no-default-export": "error"
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^#lib/(?:[^/]+/)*_",
                "message": "Import a public library capability module, not a private implementation module."
              }
            ]
          }
        ]
      }
    }
  ]
}
