{
  "compilerOptions": {
    "noEmit": true,
    "noEmitOnError": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],

    /* Linting */
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "fixtures/**/*.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [".attic/**/*.ts"]
}
