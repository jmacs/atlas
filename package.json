{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Unraid server app",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#fixtures": "./fixtures/register.ts",
    "#lib/*.ts": "./lib/*.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@jellyfin/sdk": "0.13.0",
    "@lucide/icons": "^1.43.0",
    "alpinejs": "3.15.8",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.7",
    "htmx.org": "^2.0.10",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:css",
    "build:server": "tsc --project tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/index.css -o public/styles/app.css --minify",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "clean": "rm -rf dist && rm -rf public/styles",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:css\"",
    "dev:server": "tsx watch src/main.ts",
    "dev:css": "tailwindcss -i src/styles/index.css -o public/styles/app.css --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "prebuild": "npm run clean && npm run typecheck",
    "playwright:test": "playwright test",
    "playwright:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node dist/main.js"
  }
}
