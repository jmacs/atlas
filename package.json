{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Unraid server app",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "htmx.org": "^2.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "dev": "tsx watch server/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/main.js"
  }
}
